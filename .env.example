COMPOSE_PROJECT_NAME=itis
FRONTEND_PORT=3000
APP_PORT=8080
JAVA_TOOL_OPTIONS=-Duser.timezone=Asia/Ho_Chi_Minh
POSTGRES_PORT=5433
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MAIL_UI_PORT=8025
MAIL_SMTP_PORT=1025

POSTGRES_USER=itis
POSTGRES_PASSWORD=itis_local_database_password
POSTGRES_DB=itis_academy
JWT_SECRET=itis_local_development_secret_change_before_deploying_2026
JWT_EXPIRATION_MS=300000
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000
CORS_ALLOWED_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_WEB=INFO
LOGGING_LEVEL_ORG_HIBERNATE_SQL=INFO

MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=itis_local_minio_password
MINIO_REGION=ap-southeast-1
MINIO_BUCKET=lms-itis
MINIO_URL=http://localhost:9000/lms-itis
CDN_URL=http://localhost:9000/lms-itis
NEXT_PUBLIC_API_URL=http://localhost:8080

# Local email is captured by Mailpit: http://localhost:8025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=local
SMTP_PASSWORD=local
EMAIL_FROM=noreply@itisacademy.local
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=false
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=false
