SERVER_PORT=8080

POSTGRES_USER=itis
POSTGRES_PASSWORD=academyforitis2026
POSTGRES_DB=itis_academy
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DATABASE_URL=jdbc:postgresql://localhost:5432/itis_academy
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4173,http://localhost:5173

# JWT (access: 5 minutes, refresh: 7 days) — must be ≥ 32 UTF-8 bytes
JWT_SECRET=academyforitis2026_ITISLANHA_secret
JWT_EXPIRATION_MS=300000
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000

COOKIE_SECURE=true

REDIS_HOST=localhost
REDIS_PORT=6379

# Video HLS transcode worker (requires ffmpeg on PATH for local runs)
# Upload returns immediately; Redis worker encodes one job at a time.
VIDEO_TRANSCODE_WORKER_ENABLED=true
VIDEO_TRANSCODE_QUEUE_KEY=video:transcode
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Cap CPU so API stays responsive on small VPS (minimum defaults)
VIDEO_TRANSCODE_FFMPEG_THREADS=1
VIDEO_TRANSCODE_X264_PRESET=veryfast
VIDEO_TRANSCODE_NICE_ENABLED=true
VIDEO_TRANSCODE_NICE_VALUE=19
VIDEO_TRANSCODE_IONICE_ENABLED=true
VIDEO_TRANSCODE_IONICE_CLASS=2
VIDEO_TRANSCODE_IONICE_LEVEL=7

